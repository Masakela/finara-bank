# Local configuration (copy to .env). On Render these are set by the blueprint.
# Leave everything unset to run the zero-setup SQLite backend: `node server.js`.

# To run against PostgreSQL locally:
# DB_BACKEND=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/finara
# PGSSLMODE=disable          # local Postgres usually needs no SSL; Render sets SSL automatically

# PORT=7080
# SQLITE_FILE=finara.sqlite  # persist the SQLite backend to a file instead of memory
